  "programs": [
    {
      "topic": "sales",
      "tier": "alert",
      "name": "小規模事業者持続化補助金",
      "shortName": "持続化補助金",
      "summary": "従業員の少ない小規模事業者が、チラシ・ホームページ・店舗改装などで新しい客を増やす取り組みに使える補助金です。通常枠は補助上限50万円（インボイス・賃上げの特例で上乗せあり）、補助率は原則2/3で、創業型は上限200万円です。申請の前に、地域の商工会・商工会議所で様式4を発行してもらう必要があります。",
      "officialUrl": "https://r6.jizokukahojokin.info/",
      "contacts": [
        {
          "label": "商工会議所地区 事務局（審査・申請）",
          "phone": "03-6634-9307",
          "hours": "平日9:00〜12:00、13:00〜17:00"
        },
        {
          "label": "商工会議所地区 申請システムの窓口",
          "phone": "03-6636-5410",
          "hours": "平日9:00〜12:00、13:00〜17:00"
        },
        {
          "label": "商工会地区 申請システムの窓口",
          "phone": "03-6636-5569",
          "hours": "平日9:00〜12:00、13:00〜17:00"
        },
        {
          "label": "創業型 事務局",
          "phone": "03-6739-3890",
          "hours": "平日9:00〜12:00、13:00〜17:00"
        },
        {
          "label": "災害支援枠（熊本地震）商工会議所地区 事務局",
          "phone": "03-6633-2478",
          "hours": "平日9:00〜12:00、13:00〜17:00"
        }
      ],
      "checklist": [
        {
          "id": "gbizid",
          "text": "GビズIDプライムを取得する（オンライン申請は最短即日、書類の郵送だと最大1か月かかります）"
        },
        {
          "id": "region",
          "text": "お店や事務所の場所が商工会議所の地区か商工会の地区かを確かめる"
        },
        {
          "id": "plan",
          "text": "経営計画と補助事業計画を電子申請システムに入力する"
        },
        {
          "id": "form4",
          "text": "地域の商工会・商工会議所に様式4（事業支援計画書）の発行を早めに頼む"
        },
        {
          "id": "quote",
          "text": "使う予定の経費の見積書をそろえる"
        },
        {
          "id": "guidelines",
          "text": "公募要領で対象になる経費と特例（インボイス・賃上げ）の条件を確認する"
        }
      ],
